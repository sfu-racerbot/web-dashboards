<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>web_dashboard</name>
  <version>0.1.0</version>
  <description>The car-side server for the web-dashboards site (sfu-racerbot/web-dashboards): streams map, LiDAR, pose, telemetry and drive intent over a WebSocket, with bounded tuning, process stop, map delete and SLAM reset. Also ships the foxglove_bridge config for the site's Advanced dashboard.</description>
  <maintainer email="bryanmaubc@gmail.com">racerbotcar-2</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>ackermann_msgs</depend>
  <depend>std_msgs</depend>
  <!-- drive_intent is OPTIONAL and deliberately not declared: it belongs
       to the car workspace that publishes /drive_intent, and a team
       without it still gets a working dashboard with the intent panel
       off (web_dashboard/intent.py). Its tests need it importable. -->
  <depend>ament_index_python</depend>
  <depend>python3-tornado</depend>
  <depend>python3-psutil</depend>
  <!-- diffing occupancy grids for map patches, see mapstream.py -->
  <depend>python3-numpy</depend>
  <!-- The Reset service for the dashboard's live-SLAM reset. exec_depend,
       not depend: this package's tests deliberately run with no ROS
       sourced, and the import is guarded so a machine without
       slam_toolbox still gets a working dashboard. -->
  <exec_depend>slam_toolbox</exec_depend>
  <!-- foxglove_bridge_launch.py: the site's Advanced dashboard (Lichtblick).
       apt: ros-jazzy-foxglove-bridge -->
  <exec_depend>foxglove_bridge</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <!-- test_foxglove_bridge_config.py reads the bridge YAML -->
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
