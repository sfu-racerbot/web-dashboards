# Installed by car/systemd/install.sh, which fills in @USER@ and @WORKSPACE@.
[Unit]
Description=Racerbot: The camera's MJPEG stream (usb_cam_stream), port 9090
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Environment=HOME=/home/@USER@
# Every ROS 2 command needs both workspaces sourced, in this order.
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && source @WORKSPACE@/install/setup.bash && exec ros2 launch usb_cam_stream usb_cam_stream_launch.py'
# SIGINT is what Ctrl+C sends; ros2 launch shuts its nodes down cleanly on it.
KillSignal=SIGINT
TimeoutStopSec=15
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
